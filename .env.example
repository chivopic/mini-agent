# API Key（OpenAI、DeepSeek 或其它 OpenAI-compatible 服务商）
# 密钥只走环境变量或本文件；TOML 里的 api_key / openai_api_key / OPENAI_API_KEY 会被忽略。
OPENAI_API_KEY=your_api_key_here

# 可选：自定义 Base URL（DeepSeek 请设为 https://api.deepseek.com）
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_BASE 同样会被识别

# 可选：默认模型（代码默认 gpt-4o-mini；DeepSeek 推荐 deepseek-v4）
# MINI_AGENT_MODEL=deepseek-v4

# 可选：会话目录（默认 ~/.mini-agent/sessions）
# MINI_AGENT_SESSIONS_DIR=/path/to/sessions

# 可选：费率 JSON 路径（默认 ~/.mini-agent/pricing.json）
# MINI_AGENT_PRICING_FILE=/path/to/pricing.json

# 可选：写入 ~/.mini-agent/debug.log
# MINI_AGENT_DEBUG=1

# 用户配置：~/.mini-agent/config.toml
# 项目配置：<workspace>/.mini-agent.toml
# 合并优先级（高覆盖低）：CLI > 环境变量（.env 不覆盖已有键）> 项目 TOML > 用户 TOML > 默认
# 仍识别 OPENAI_*、MINI_AGENT_MODEL、MINI_AGENT_SESSIONS_DIR、MINI_AGENT_PRICING_FILE、MINI_AGENT_DEBUG
