# API Key (OpenAI 或 DeepSeek)
# 密钥只走环境变量或本文件；TOML 里的 api_key / OPENAI_API_KEY 会被忽略。
OPENAI_API_KEY=your_api_key_here

# 可选：自定义 Base URL（若使用 DeepSeek，请设置为 https://api.deepseek.com）
# OPENAI_BASE_URL=https://api.deepseek.com

# 可选：默认模型（默认 gpt-4o-mini，使用 DeepSeek 时推荐 deepseek-chat）
# MINI_AGENT_MODEL=deepseek-chat

# 可选：用户配置 ~/.mini-agent/config.toml ；项目配置 <workspace>/.mini-agent.toml
# 合并优先级（高覆盖低）：CLI > 环境变量（.env 不覆盖已有键）> 项目 TOML > 用户 TOML > 默认
# 仍识别 MINI_AGENT_SESSIONS_DIR、MINI_AGENT_PRICING_FILE、OPENAI_*
